    TW0: H22(1)  # egress::hdr.cntrl.global_seq_no if egress::hdr.cntrl.$valid
    H16: H22(1)  # egress::hdr.cntrl.ring_view if egress::hdr.cntrl.$valid
    TW2: H22(6)
        # - bit[31..28]: egress::hdr.ipv4.version if egress::hdr.ipv4.$valid
        # - bit[27..24]: egress::hdr.ipv4.ihl if egress::hdr.ipv4.$valid
        # - bit[23..16]: egress::hdr.ipv4.tos if egress::hdr.ipv4.$valid
        # - bit[15..0]: egress::hdr.ipv4.len if egress::hdr.ipv4.$valid
    TB2: H22(6)  # egress::hdr.ipv4.id.8-15 if egress::hdr.ipv4.$valid
    TB1: H22(6)  # egress::hdr.ipv4.id.0-7 if egress::hdr.ipv4.$valid
    TH1: H22(6)
        # - bit[15..13]: egress::hdr.ipv4.flags if egress::hdr.ipv4.$valid
        # - bit[12..0]: egress::hdr.ipv4.frag if egress::hdr.ipv4.$valid
    TW3: H22(6)
        # - bit[31..24]: egress::hdr.ipv4.ttl if egress::hdr.ipv4.$valid
        # - bit[23..16]: egress::hdr.ipv4.proto if egress::hdr.ipv4.$valid
        # - bit[15..0]: egress::hdr.ipv4.chksum if egress::hdr.ipv4.$valid
    TB10: H22(6)  # egress::hdr.ipv4.src.24-31 if egress::hdr.ipv4.$valid
    TB9: H22(6)  # egress::hdr.ipv4.src.16-23 if egress::hdr.ipv4.$valid
    TB8: H22(6)  # egress::hdr.ipv4.src.8-15 if egress::hdr.ipv4.$valid
    TB3: H22(6)  # egress::hdr.ipv4.src.0-7 if egress::hdr.ipv4.$valid
    TH17: H22(6)  # egress::hdr.ipv4.dst.16-31 if egress::hdr.ipv4.$valid
    TH16: H22(6)  # egress::hdr.ipv4.dst.0-15 if egress::hdr.ipv4.$valid
    TW8: H22(7)
        # - bit[31..16]: egress::hdr.udp.src_port if egress::hdr.udp.$valid
        # - bit[15..0]: egress::hdr.udp.dst_port if egress::hdr.udp.$valid
    TH5: H22(7)  # egress::hdr.udp.len if egress::hdr.udp.$valid
    TH4: H22(7)  # egress::hdr.udp.chksum if egress::hdr.udp.$valid
    TB0: H22(3)  # egress::hdr.induce_view.drop_cntrl if egress::hdr.induce_view.$valid
    B19: H22(4)  # egress::hdr.trigger_view.leader_switch_id if egress::hdr.trigger_view.$valid
    H16: H22(4)  # egress::hdr.trigger_view.current_ring_view if egress::hdr.trigger_view.$valid
    TB1: H22(4)  # egress::hdr.trigger_view.view_member_switch_id if egress::hdr.trigger_view.$valid
    TW0: H22(4)  # egress::hdr.trigger_view.highest_seen_seq_no if egress::hdr.trigger_view.$valid
    TB0: H22(4)  # egress::hdr.trigger_view.hops if egress::hdr.trigger_view.$valid
    TH1: H22(5)
        # - bit[15..8]: egress::hdr.finalize_view.leader_switch_id if egress::hdr.finalize_view.$valid
        # - bit[7..0]: egress::hdr.finalize_view.view_member_switch_id if egress::hdr.finalize_view.$valid
    H16: H22(5)  # egress::hdr.finalize_view.current_ring_view if egress::hdr.finalize_view.$valid
    TB1: H22(5)  # egress::hdr.finalize_view.next_switch_id if egress::hdr.finalize_view.$valid
    TW0: H22(5)  # egress::hdr.finalize_view.highest_quorum_seq_no if egress::hdr.finalize_view.$valid
    TB0: H22(5)  # egress::hdr.finalize_view.hops if egress::hdr.finalize_view.$valid
    B21: H22(8)  # egress::hdr.ring_type.type.8-15 if egress::hdr.ring_type.$valid
    B19: H22(8)  # egress::hdr.ring_type.type.0-7 if egress::hdr.ring_type.$valid
    TW9: H22(8)
        # - bit[31..16]: egress::hdr.ring_type.num_entries if egress::hdr.ring_type.$valid
        # - bit[15..0]: egress::hdr.ring_type.shard_id if egress::hdr.ring_type.$valid
    TB0: H22(8)  # egress::hdr.ring_type.switch_to_process if egress::hdr.ring_type.$valid
    TW1: H22(8)  # egress::hdr.ring_type.start_ts.16-47 if egress::hdr.ring_type.$valid
    H17: H22(8)  # egress::hdr.ring_type.start_ts.0-15 if egress::hdr.ring_type.$valid
    TW0: H22(8)  # egress::hdr.ring_type.end_ts.16-47 if egress::hdr.ring_type.$valid
    H16: H22(8)  # egress::hdr.ring_type.end_ts.0-15 if egress::hdr.ring_type.$valid
    H18: H22(8)  # egress::hdr.ring_type.raw_elapsed_time if egress::hdr.ring_type.$valid
    W17: H22(8)  # egress::hdr.ring_type.pipe_ts if egress::hdr.ring_type.$valid
    TW11: H22(9)
        # - bit[31..16]: egress::hdr.append.nonce if egress::hdr.append.$valid
        # - bit[15..0]: egress::hdr.append.payload_size if egress::hdr.append.$valid
    TW18: H22(9)  # egress::hdr.append.stream_id if egress::hdr.append.$valid
    TW17: H22(9)  # egress::hdr.append.g_idx if egress::hdr.append.$valid
    TW10: H22(9)
        # - bit[31..16]: egress::hdr.append.cntrl_pkt_it if egress::hdr.append.$valid
        # - bit[15..0]: egress::hdr.append.recv_port if egress::hdr.append.$valid
    TH3: H22(9)  # egress::hdr.append.exp_type if egress::hdr.append.$valid
    TH2: H22(9)  # egress::hdr.append.start_ts.32-47 if egress::hdr.append.$valid
    TW16: H22(9)  # egress::hdr.append.start_ts.0-31 if egress::hdr.append.$valid
    TH2: H22(10)  # egress::hdr.read.nonce if egress::hdr.read.$valid
    TW17: H22(10)  # egress::hdr.read.payload_size if egress::hdr.read.$valid
    TW16: H22(10)  # egress::hdr.read.stream_id if egress::hdr.read.$valid
    TW11: H22(10)  # egress::hdr.read.g_idx if egress::hdr.read.$valid
    TW10: H22(10)
        # - bit[31..16]: egress::hdr.read.ring_view if egress::hdr.read.$valid
        # - bit[15..0]: egress::hdr.read.recv_port if egress::hdr.read.$valid
    TH3: H22(11)  # egress::hdr.tail.nonce if egress::hdr.tail.$valid
    TH2: H22(11)
        # - bit[15..8]: egress::hdr.tail.hops if egress::hdr.tail.$valid
        # - bit[7..0]: egress::hdr.tail.start_switch_id if egress::hdr.tail.$valid
    TW10: H22(11)  # egress::hdr.tail.tail_seq_no if egress::hdr.tail.$valid
    TH26: H22(11)  # egress::hdr.tail.recv_port if egress::hdr.tail.$valid
    TW16: H22(12)  # egress::hdr.sub.g_idx if egress::hdr.sub.$valid
    TW11: H22(12)  # egress::hdr.sub.stream_id if egress::hdr.sub.$valid
    TW10: H22(12)
        # - bit[31..16]: egress::hdr.sub.recv_port if egress::hdr.sub.$valid
        # - bit[15..0]: egress::hdr.sub.subscribe_port if egress::hdr.sub.$valid
    B18: H22(2)  # egress::hdr.canary.magic if egress::hdr.canary.$valid
  drop_ctl: B17(0..2)  # bit[2..0]: egress::eg_intr_md_for_dprsr.drop_ctl
  egress_unicast_port: H19(0..8)  # bit[8..0]: egress::eg_intr_md.egress_port
stage 0 ingress:
  phase0_match MyParser.$PORT_METADATA:
