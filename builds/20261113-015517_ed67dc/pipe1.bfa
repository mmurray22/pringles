    - { name : hdr.ring_type.end_ts, live_start : parser, live_end : deparser, mutually_exclusive_with: [ hdr.cntrl.global_seq_no, hdr.trigger_view.highest_seen_seq_no, hdr.finalize_view.highest_quorum_seq_no ] }
    TW1:
    - { name : hdr.ring_type.start_ts, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B16:
    - { name : eg_intr_md_for_dprsr.mirror_type, live_start : 4, live_end : 4, mutually_exclusive_with: [  ] }
    B17:
    - { name : eg_intr_md_for_dprsr.drop_ctl, live_start : 7, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : meta.queue_congest, live_start : 4, live_end : 6, mutually_exclusive_with: [  ] }
    B18:
    - { name : hdr.canary.magic, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B19:
    - { name : hdr.trigger_view.leader_switch_id, live_start : parser, live_end : deparser, mutually_exclusive_with: [ hdr.ring_type.type ] }
    - { name : hdr.ring_type.type, live_start : parser, live_end : deparser, mutually_exclusive_with: [ hdr.trigger_view.leader_switch_id ] }
    B20:
    - { name : meta.leader_switch_id, live_start : 0, live_end : 1, mutually_exclusive_with: [  ] }
    B21:
    - { name : hdr.ring_type.type, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B22:
    - { name : eg_intr_md.deq_qdepth, live_start : parser, live_end : 5, mutually_exclusive_with: [  ] }
    - { name : meta.queue_congest, live_start : 4, live_end : 6, mutually_exclusive_with: [  ] }
    B23:
    - { name : meta.queue_congest, live_start : 4, live_end : 6, mutually_exclusive_with: [  ] }
    B24:
    - { name : meta.view_change_active, live_start : 3, live_end : 7, mutually_exclusive_with: [  ] }
    B25:
    - { name : meta.accept_finalize_view, live_start : 1, live_end : 2, mutually_exclusive_with: [  ] }
    H16:
    - { name : hdr.cntrl.ring_view, live_start : parser, live_end : deparser, mutually_exclusive_with: [ hdr.trigger_view.current_ring_view, hdr.finalize_view.current_ring_view, hdr.ring_type.end_ts ] }
    - { name : hdr.trigger_view.current_ring_view, live_start : parser, live_end : deparser, mutually_exclusive_with: [ hdr.cntrl.ring_view, hdr.finalize_view.current_ring_view, hdr.ring_type.end_ts ] }
    - { name : hdr.finalize_view.current_ring_view, live_start : parser, live_end : deparser, mutually_exclusive_with: [ hdr.cntrl.ring_view, hdr.trigger_view.current_ring_view, hdr.ring_type.end_ts ] }
    - { name : hdr.ring_type.end_ts, live_start : parser, live_end : deparser, mutually_exclusive_with: [ hdr.cntrl.ring_view, hdr.trigger_view.current_ring_view, hdr.finalize_view.current_ring_view ] }
    H17:
    - { name : hdr.ring_type.start_ts, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H18:
    - { name : hdr.ring_type.raw_elapsed_time, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H19:
    - { name : eg_intr_md.egress_port, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H20:
    - { name : meta.ring_view, live_start : 0, live_end : 3, mutually_exclusive_with: [  ] }
    H21:
    - { name : hdr.ethernet.type, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H22:
    - { name : hdr.ethernet.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.cntrl.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.canary.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.induce_view.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.trigger_view.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.finalize_view.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.ipv4.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.udp.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.ring_type.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.append.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.read.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.tail.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.sub.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H23:
    - { name : meta.accept_view_change, live_start : 3, live_end : 4, mutually_exclusive_with: [  ] }
    W16:
    - { name : eg_intr_md_from_prsr.global_tstamp, live_start : parser, live_end : 7, mutually_exclusive_with: [  ] }
    W17:
    - { name : hdr.ring_type.pipe_ts, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    W18:
    - { name : meta.elapse_time, live_start : 6, live_end : 7, mutually_exclusive_with: [  ] }
    W19:
    - { name : eg_intr_md.deq_qdepth, live_start : parser, live_end : 5, mutually_exclusive_with: [  ] }
    - { name : meta.queue_congest, live_start : 4, live_end : 6, mutually_exclusive_with: [  ] }
parser ingress:
  start: $entry_point
  init_zero: [ W1, TH22, B3, H14, B8, B12, B13, B9, B6, B10, B5, B11, H10, H11, W15, W4, W5, W6, W32, H2, W33, H15, H32 ]
  bitwise_or: [ H15 ]
  hdr_len_adj: 16
  states:
    $entry_point:
      *:
        56..59: W1  # buffer mapped I/O: bit[448..479] -> W1 bit[31..0]: ingress::ig_intr_md_from_prsr.global_tstamp[31:0].0-31
        54..55: TH22  # buffer mapped I/O: bit[432..447] -> TH22 bit[15..0]: ingress::ig_intr_md_from_prsr.global_tstamp[47:32].32-47
        load: { byte1 : 0 }
        buf_req: 1
        next: start
    start:
      match: [ byte1 ]
      0b1*******:
        2..3: H3  # ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W7  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 8
        buf_req: 8
        next: end
      0b0*******:
        2..3: H3  # ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W7  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        load: { half : 0..1 }
        shift: 8
        buf_req: 8
        next: TofinoIngressParser_parse_port_metadata
    TofinoIngressParser_parse_port_metadata:
      match: [ half ]
      0b*******011000100:
        8..9: H12
            # - bit[0..2] -> H12 bit[15..13]: ingress::hdr.timer._pad1
            # - bit[3..4] -> H12 bit[12..11]: ingress::hdr.timer.pipe_id
            # - bit[5..7] -> H12 bit[10..8]: ingress::hdr.timer.app_id
            # - bit[8..15] -> H12 bit[7..0]: ingress::hdr.timer._pad2
        10..13: TW6
            # - bit[16..31] -> TW6 bit[31..16]: ingress::hdr.timer.batch_id
            # - bit[32..47] -> TW6 bit[15..0]: ingress::hdr.timer.packet_id
        load: { half : 26..27 }
        shift: 14
        buf_req: 28
        next: parse_ethernet
      0b*******011000101:
        8..9: H12
            # - bit[0..2] -> H12 bit[15..13]: ingress::hdr.timer._pad1
            # - bit[3..4] -> H12 bit[12..11]: ingress::hdr.timer.pipe_id
            # - bit[5..7] -> H12 bit[10..8]: ingress::hdr.timer.app_id
            # - bit[8..15] -> H12 bit[7..0]: ingress::hdr.timer._pad2
        10..13: TW6
            # - bit[16..31] -> TW6 bit[31..16]: ingress::hdr.timer.batch_id
            # - bit[32..47] -> TW6 bit[15..0]: ingress::hdr.timer.packet_id
        load: { half : 26..27 }
        shift: 14
        buf_req: 28
        next: parse_ethernet
      0b*******011000110:
        8..9: H12
            # - bit[0..2] -> H12 bit[15..13]: ingress::hdr.timer._pad1
            # - bit[3..4] -> H12 bit[12..11]: ingress::hdr.timer.pipe_id
            # - bit[5..7] -> H12 bit[10..8]: ingress::hdr.timer.app_id
            # - bit[8..15] -> H12 bit[7..0]: ingress::hdr.timer._pad2
        10..13: TW6
            # - bit[16..31] -> TW6 bit[31..16]: ingress::hdr.timer.batch_id
            # - bit[32..47] -> TW6 bit[15..0]: ingress::hdr.timer.packet_id
        load: { half : 26..27 }
        shift: 14
        buf_req: 28
        next: parse_ethernet
      0b*******011000111:
        8..9: H12
            # - bit[0..2] -> H12 bit[15..13]: ingress::hdr.timer._pad1
            # - bit[3..4] -> H12 bit[12..11]: ingress::hdr.timer.pipe_id
            # - bit[5..7] -> H12 bit[10..8]: ingress::hdr.timer.app_id
            # - bit[8..15] -> H12 bit[7..0]: ingress::hdr.timer._pad2
        10..13: TW6
            # - bit[16..31] -> TW6 bit[31..16]: ingress::hdr.timer.batch_id
            # - bit[32..47] -> TW6 bit[15..0]: ingress::hdr.timer.packet_id
        load: { half : 26..27 }
        shift: 14
        buf_req: 28
        next: parse_ethernet
      0x****:
        load: { half : 20..21 }
        shift: 8
        buf_req: 22
        next: parse_ethernet
    parse_ethernet:
      match: [ half ]
      0x0820:
        0..1: H7  # ingress::hdr.ethernet.dst[47:32].32-47
        2..5: W11  # ingress::hdr.ethernet.dst[31:0].0-31
        6..7: H8  # ingress::hdr.ethernet.src[47:32].32-47
        8..11: W12  # ingress::hdr.ethernet.src[31:0].0-31
        12..13: TH18  # ingress::hdr.ethernet.type
        H15: 2  # value 1 -> H15 bit[1]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: parse_control
      0x0890:
        0..1: H7  # ingress::hdr.ethernet.dst[47:32].32-47
        2..5: W11  # ingress::hdr.ethernet.dst[31:0].0-31
        6..7: H8  # ingress::hdr.ethernet.src[47:32].32-47
        8..11: W12  # ingress::hdr.ethernet.src[31:0].0-31
        12..13: TH18  # ingress::hdr.ethernet.type
        H15: 2  # value 1 -> H15 bit[1]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: parse_induce_view
      0x0900:
        0..1: H7  # ingress::hdr.ethernet.dst[47:32].32-47
        2..5: W11  # ingress::hdr.ethernet.dst[31:0].0-31
        6..7: H8  # ingress::hdr.ethernet.src[47:32].32-47
        8..11: W12  # ingress::hdr.ethernet.src[31:0].0-31
        12..13: TH18  # ingress::hdr.ethernet.type
        H15: 2  # value 1 -> H15 bit[1]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: parse_trigger_view
      0x0910:
        0..1: H7  # ingress::hdr.ethernet.dst[47:32].32-47
        2..5: W11  # ingress::hdr.ethernet.dst[31:0].0-31
        6..7: H8  # ingress::hdr.ethernet.src[47:32].32-47
        8..11: W12  # ingress::hdr.ethernet.src[31:0].0-31
        12..13: TH18  # ingress::hdr.ethernet.type
        H15: 2  # value 1 -> H15 bit[1]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: parse_finalize_view
      0x0800:
        0..1: H7  # ingress::hdr.ethernet.dst[47:32].32-47
        2..5: W11  # ingress::hdr.ethernet.dst[31:0].0-31
        6..7: H8  # ingress::hdr.ethernet.src[47:32].32-47
        8..11: W12  # ingress::hdr.ethernet.src[31:0].0-31
        12..13: TH18  # ingress::hdr.ethernet.type
        H15: 2  # value 1 -> H15 bit[1]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: parse_ipv4
      0x****:
        0..1: H7  # ingress::hdr.ethernet.dst[47:32].32-47
        2..5: W11  # ingress::hdr.ethernet.dst[31:0].0-31
        6..7: H8  # ingress::hdr.ethernet.src[47:32].32-47
        8..11: W12  # ingress::hdr.ethernet.src[31:0].0-31
        12..13: TH18  # ingress::hdr.ethernet.type
        H15: 2  # value 1 -> H15 bit[1]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: end
    parse_control:
      *:
        0..3: W0  # ingress::hdr.cntrl.global_seq_no
        4..5: TH6  # ingress::hdr.cntrl.ring_view
        H15: 4  # value 1 -> H15 bit[2]: ingress::hdr.cntrl.$valid
        shift: 6
        buf_req: 6
        next: parse_canary
    parse_canary:
      *:
        0: TB4  # ingress::hdr.canary.magic
        H15: 8  # value 1 -> H15 bit[3]: ingress::hdr.canary.$valid
        shift: 1
        buf_req: 1
        next: end
    parse_induce_view:
      *:
        0: TB5  # ingress::hdr.induce_view.drop_cntrl
        H15: 16  # value 1 -> H15 bit[4]: ingress::hdr.induce_view.$valid
        shift: 1
        buf_req: 1
        next: parse_canary
    parse_trigger_view:
      *:
        0: B4  # ingress::hdr.trigger_view.leader_switch_id
        1..2: TH6  # ingress::hdr.trigger_view.current_ring_view
        3: B1  # ingress::hdr.trigger_view.view_member_switch_id
        4..7: W0  # ingress::hdr.trigger_view.highest_seen_seq_no
        8: B0  # ingress::hdr.trigger_view.hops
        H15: 32  # value 1 -> H15 bit[5]: ingress::hdr.trigger_view.$valid
        shift: 9
        buf_req: 9
        next: parse_canary
    parse_finalize_view:
      *:
        0: B4  # ingress::hdr.finalize_view.leader_switch_id
        1: B1  # ingress::hdr.finalize_view.view_member_switch_id
        2..3: TH6  # ingress::hdr.finalize_view.current_ring_view
        4: B7  # ingress::hdr.finalize_view.next_switch_id
        5..8: TW4  # ingress::hdr.finalize_view.highest_quorum_seq_no
        9: B0  # ingress::hdr.finalize_view.hops
        H15: 64  # value 1 -> H15 bit[6]: ingress::hdr.finalize_view.$valid
        shift: 10
        buf_req: 10
        next: parse_canary
    parse_ipv4:
      *:
        0..3: TW4
            # - bit[0..3] -> TW4 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW4 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW4 bit[23..16]: ingress::hdr.ipv4.tos
            # - bit[16..31] -> TW4 bit[15..0]: ingress::hdr.ipv4.len
        4..7: TW5
            # - bit[32..47] -> TW5 bit[31..16]: ingress::hdr.ipv4.id
            # - bit[48..50] -> TW5 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TW5 bit[12..0]: ingress::hdr.ipv4.frag
        8: B0  # ingress::hdr.ipv4.ttl
        9: TB6  # ingress::hdr.ipv4.proto
        10..11: TH21  # ingress::hdr.ipv4.chksum
        12..15: TW14  # ingress::hdr.ipv4.src
        16..19: W14  # ingress::hdr.ipv4.dst
        20..21: TH7  # ingress::hdr.udp.src_port
        22..23: TH6  # ingress::hdr.udp.dst_port
        28..29: H13  # ingress::hdr.ring_type.type
        H15: 896
            # - value 1 -> H15 bit[7]: ingress::hdr.ipv4.$valid
            # - value 1 -> H15 bit[8]: ingress::hdr.udp.$valid
            # - value 1 -> H15 bit[9]: ingress::hdr.ring_type.$valid
        shift: 24
        buf_req: 30
        next: parse_ipv4.$split_0
    parse_ipv4.$split_0:
      *:
        0..3: TW7
            # - bit[0..15] -> TW7 bit[31..16]: ingress::hdr.udp.len
            # - bit[16..31] -> TW7 bit[15..0]: ingress::hdr.udp.chksum
        6..9: W2
            # - bit[48..63] -> W2 bit[31..16]: ingress::hdr.ring_type.num_entries
            # - bit[64..79] -> W2 bit[15..0]: ingress::hdr.ring_type.shard_id
        10: TB5  # ingress::hdr.ring_type.switch_to_process
        11..12: H5  # ingress::hdr.ring_type.start_ts[47:32].32-47
        13..16: W9  # ingress::hdr.ring_type.start_ts[31:0].0-31
        17..18: H6  # ingress::hdr.ring_type.end_ts[47:32].32-47
        19..22: W10  # ingress::hdr.ring_type.end_ts[31:0].0-31
        23..24: TH19  # ingress::hdr.ring_type.raw_elapsed_time
        load: { half : 4..5 }
        shift: 25
        buf_req: 25
        next: parse_ipv4.$split_1
    parse_ipv4.$split_1:
      match: [ half ]
      0x0860:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_append
      0x0862:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_append
      0x0861:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_append
      0x0870:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_read
      0x0871:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_read
      0x0840:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_tail
      0x0850:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_sub
      0x****:
        0..3: W13  # ingress::hdr.ring_type.pipe_ts
        shift: 4
        buf_req: 4
        next: parse_canary
    parse_append:
      *:
        0..1: TH9  # ingress::hdr.append.nonce
        2..3: TH8  # ingress::hdr.append.payload_size
        4..7: W0  # ingress::hdr.append.stream_id
        8..11: W3  # ingress::hdr.append.g_idx
        12..13: H9  # ingress::hdr.append.cntrl_pkt_it
        14..15: TH10  # ingress::hdr.append.recv_port
        16: B4  # ingress::hdr.append.exp_type[15:8].8-15
        17: B1  # ingress::hdr.append.exp_type[7:0].0-7
        20..23: W8  # ingress::hdr.append.start_ts[31:0].0-31
        H15: 1024  # value 1 -> H15 bit[10]: ingress::hdr.append.$valid
        shift: 18
        buf_req: 24
        next: parse_append.$split_0
    parse_append.$split_0:
      *:
        0..1: H4  # ingress::hdr.append.start_ts[47:32].32-47
        shift: 6
        buf_req: 6
        next: parse_canary
    parse_read:
      *:
        0..1: TH20  # ingress::hdr.read.nonce
        2..5: TW13  # ingress::hdr.read.payload_size
        6..9: TW12  # ingress::hdr.read.stream_id
        10..11: TH11  # ingress::hdr.read.g_idx[31:16].16-31
        12..13: TH10  # ingress::hdr.read.g_idx[15:0].0-15
        14..15: TH9  # ingress::hdr.read.ring_view
        H15: 2048  # value 1 -> H15 bit[11]: ingress::hdr.read.$valid
        shift: 16
        buf_req: 16
        next: parse_read.$split_0
    parse_read.$split_0:
      *:
        0..1: TH8  # ingress::hdr.read.recv_port
        shift: 2
        buf_req: 2
        next: parse_canary
    parse_tail:
      *:
        0..1: TH11  # ingress::hdr.tail.nonce
        2: B1  # ingress::hdr.tail.hops
        3: B4  # ingress::hdr.tail.start_switch_id
        4..5: TH9  # ingress::hdr.tail.tail_seq_no[31:16].16-31
        6..7: TH8  # ingress::hdr.tail.tail_seq_no[15:0].0-15
        8..9: TH10  # ingress::hdr.tail.recv_port
        H15: 4096  # value 1 -> H15 bit[12]: ingress::hdr.tail.$valid
        shift: 10
        buf_req: 10
        next: parse_canary
    parse_sub:
      *:
        0..3: TW13  # ingress::hdr.sub.g_idx
        4..7: TW12  # ingress::hdr.sub.stream_id
        8..9: TH9  # ingress::hdr.sub.recv_port
        10..11: TH8  # ingress::hdr.sub.subscribe_port
        H15: 8192  # value 1 -> H15 bit[13]: ingress::hdr.sub.$valid
        shift: 12
        buf_req: 12
        next: parse_canary
deparser ingress:
  dictionary:
    H12: H15(0)
        # - bit[15..13]: ingress::hdr.timer._pad1 if ingress::hdr.timer.$valid
        # - bit[12..11]: ingress::hdr.timer.pipe_id if ingress::hdr.timer.$valid
        # - bit[10..8]: ingress::hdr.timer.app_id if ingress::hdr.timer.$valid
        # - bit[7..0]: ingress::hdr.timer._pad2 if ingress::hdr.timer.$valid
    TW6: H15(0)
        # - bit[31..16]: ingress::hdr.timer.batch_id if ingress::hdr.timer.$valid
        # - bit[15..0]: ingress::hdr.timer.packet_id if ingress::hdr.timer.$valid
    H7: H15(1)  # ingress::hdr.ethernet.dst.32-47 if ingress::hdr.ethernet.$valid
    W11: H15(1)  # ingress::hdr.ethernet.dst.0-31 if ingress::hdr.ethernet.$valid
    H8: H15(1)  # ingress::hdr.ethernet.src.32-47 if ingress::hdr.ethernet.$valid
    W12: H15(1)  # ingress::hdr.ethernet.src.0-31 if ingress::hdr.ethernet.$valid
